{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JevCode",
  "version": "0.2.0",
  "identifier": "dev.jevcode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "JevCode", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "createUpdaterArtifacts": true, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"] },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNkNERUZDMDFBQTI5N0QKUldSOUthb0IvTjVza2JUNU91WTRuL1gycFNBMnpUMzJ1VWc0amRiWExoWTRhQ216OVhhbEdpMlMK",
      "endpoints": ["https://github.com/OctranTechnologies/JevCode/releases/latest/download/latest.json"]
    }
  }
}
